{
  "$schema": "https://biomejs.dev/schemas/2.5.7/schema.json",
  "files": {
    "includes": [
      "packages/**/*.ts",
      "packages/**/*.js",
      "packages/**/*.mjs",
      "scripts/**/*.mjs",
      "!packages/pi-subagents/**",
      "!packages/pi-workflows/skills/**"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 120
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true
    }
  }
}
