{
  "name": "@signalridge/pi-rules",
  "version": "1.3.0",
  "description": "Project and user rule files for Pi: always-on guidance, an on-demand rule index, and rules enforced on tool calls.",
  "type": "module",
  "license": "MIT",
  "private": false,
  "keywords": [
    "pi-package",
    "pi-extension",
    "pi",
    "rules",
    "cursor-rules",
    "guardrails"
  ],
  "piExtension": {
    "lifecycle": "experimental"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.7",
    "@earendil-works/pi-ai": "1.4.0",
    "@earendil-works/pi-coding-agent": "1.4.0",
    "@types/node": "^24.10.0",
    "typebox": "1.3.27",
    "typescript": "^6.0.0",
    "vitest": "^4.1.11"
  },
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/signalridge/pi-extensions",
    "directory": "packages/pi-rules"
  },
  "homepage": "https://github.com/signalridge/pi-extensions/tree/main/packages/pi-rules",
  "bugs": {
    "url": "https://github.com/signalridge/pi-extensions/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "files": [
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "src"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "test": "vitest run test --config vitest.config.ts",
    "check": "bun run lint && bun run typecheck && bun run test",
    "format": "biome check --write ."
  }
}
