{
  "name": "@signalridge/pi-workflows",
  "version": "1.3.2",
  "description": "Deterministic JavaScript orchestration workflows backed by pi-subagents managed spawning.",
  "type": "module",
  "license": "MIT",
  "private": false,
  "keywords": [
    "pi-package",
    "pi-extension",
    "workflow",
    "dag"
  ],
  "piExtension": {
    "lifecycle": "stable"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "^0.84.0",
    "@earendil-works/pi-tui": "^0.84.0",
    "@signalridge/pi-subagents": ">=1.5.0"
  },
  "dependencies": {
    "@signalridge/pi-subagents-protocol": "^1.3.0",
    "@sinclair/typebox": "^0.34.50",
    "acorn": "^8.16.0"
  },
  "pi": {
    "extensions": [
      "./src/index.ts"
    ],
    "skills": [
      "skills/workflow-authoring",
      "skills/workflow-patterns",
      "skills/workflow-review"
    ]
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/signalridge/pi-extensions",
    "directory": "packages/pi-workflows"
  },
  "homepage": "https://github.com/signalridge/pi-extensions/tree/main/packages/pi-workflows",
  "bugs": {
    "url": "https://github.com/signalridge/pi-extensions/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "src",
    "skills"
  ],
  "scripts": {
    "test": "vitest run test --config vitest.config.ts",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "check": "bun run lint && bun run typecheck && bun run test",
    "format": "biome check --write ."
  }
}
