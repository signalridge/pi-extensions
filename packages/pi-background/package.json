{
  "name": "@signalridge/pi-background",
  "version": "1.4.0",
  "description": "Session-owned background shell jobs and low-noise, event-driven log monitors for Pi.",
  "type": "module",
  "license": "MIT",
  "private": false,
  "keywords": [
    "pi-package",
    "pi-extension",
    "background",
    "shell",
    "monitor"
  ],
  "files": [
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "src"
  ],
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "piExtension": {
    "lifecycle": "experimental"
  },
  "scripts": {
    "check": "bun run lint && bun run typecheck && bun run test",
    "format": "biome check --write .",
    "lint": "biome check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run test --config vitest.config.ts"
  },
  "dependencies": {
    "@signalridge/pi-approval-core": "^1.2.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "1.0.4",
    "@earendil-works/pi-coding-agent": "1.0.4"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/signalridge/pi-extensions",
    "directory": "packages/pi-background"
  },
  "homepage": "https://github.com/signalridge/pi-extensions/tree/main/packages/pi-background",
  "bugs": {
    "url": "https://github.com/signalridge/pi-extensions/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
