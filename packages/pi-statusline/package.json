{
  "name": "@signalridge/pi-statusline",
  "version": "1.3.0",
  "description": "Signalridge's polished, theme-native statusline for Pi.",
  "type": "module",
  "license": "MIT",
  "private": false,
  "keywords": [
    "pi-package",
    "pi-extension",
    "pi",
    "statusline",
    "footer",
    "theme-native",
    "responsive"
  ],
  "piExtension": {
    "lifecycle": "stable"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "pi": {
    "extensions": [
      "./src/statusline.ts"
    ]
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/signalridge/pi-extensions",
    "directory": "packages/pi-statusline"
  },
  "homepage": "https://github.com/signalridge/pi-extensions/tree/main/packages/pi-statusline",
  "bugs": {
    "url": "https://github.com/signalridge/pi-extensions/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "src"
  ],
  "scripts": {
    "check": "biome check . && npm run typecheck && npm run test",
    "test": "vitest run test --config vitest.config.ts && node --test test/context-refresh.test.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome check --write ."
  },
  "dependencies": {
    "@narumitw/pi-tui-kit": "^0.49.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.7",
    "@earendil-works/pi-coding-agent": "0.84.1",
    "@earendil-works/pi-tui": "0.84.1",
    "@types/node": "26.1.2",
    "typescript": "7.0.2",
    "vitest": "4.0.18"
  }
}
