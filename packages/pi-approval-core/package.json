{
  "name": "@signalridge/pi-approval-core",
  "version": "1.2.0",
  "description": "Side-effect-free local approval contracts and reviewed native Pi tool factories.",
  "type": "module",
  "license": "MIT",
  "private": false,
  "signalridgePackage": { "kind": "library" },
  "exports": { ".": { "types": "./src/index.ts", "default": "./src/index.ts" } },
  "files": ["README.md", "LICENSE", "CHANGELOG.md", "coreAPI.md", "src"],
  "scripts": {
    "lint": "biome check src/ test/ vitest.config.ts --error-on-warnings",
    "format": "biome check --write src/ test/ vitest.config.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --config vitest.config.ts",
    "check": "bun run lint && bun run typecheck && bun run test"
  },
  "peerDependencies": { "@earendil-works/pi-coding-agent": "*", "typebox": "*" },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "1.0.4",
    "typebox": "1.3.27",
    "@biomejs/biome": "^2.5.7",
    "@types/node": "^24.10.0",
    "typescript": "^6.0.0",
    "vitest": "^4.1.11"
  },
  "repository": { "type": "git", "url": "https://github.com/signalridge/pi-extensions", "directory": "packages/pi-approval-core" },
  "homepage": "https://github.com/signalridge/pi-extensions/tree/main/packages/pi-approval-core",
  "bugs": { "url": "https://github.com/signalridge/pi-extensions/issues" },
  "publishConfig": { "access": "public" }
}
