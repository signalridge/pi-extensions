{
  "name": "@signalridge/pi-approvals",
  "version": "1.2.0",
  "description": "Opt-in experimental human approval broker for canonical native Pi mutations and bash.",
  "type": "module",
  "license": "MIT",
  "private": false,
  "keywords": ["pi-package", "pi-extension", "pi", "approvals"],
  "pi": { "extensions": ["./src/index.ts"] },
  "piExtension": { "lifecycle": "experimental" },
  "files": ["README.md", "LICENSE", "CHANGELOG.md", "src"],
  "scripts": {
    "lint": "biome check src/ test/ vitest.config.ts --error-on-warnings",
    "format": "biome check --write src/ test/ vitest.config.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --config vitest.config.ts",
    "check": "bun run lint && bun run typecheck && bun run test"
  },
  "dependencies": { "@signalridge/pi-approval-core": "^1.2.0" },
  "peerDependencies": { "@earendil-works/pi-coding-agent": "*", "@earendil-works/pi-tui": "*", "typebox": "*" },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "1.0.4",
    "@earendil-works/pi-ai": "1.0.4",
    "@earendil-works/pi-tui": "1.0.4",
    "typebox": "1.3.27",
    "@biomejs/biome": "^2.5.7",
    "@types/node": "^24.10.0",
    "typescript": "^6.0.0",
    "vitest": "^4.1.11"
  },
  "repository": { "type": "git", "url": "https://github.com/signalridge/pi-extensions", "directory": "packages/pi-approvals" },
  "homepage": "https://github.com/signalridge/pi-extensions/tree/main/packages/pi-approvals",
  "bugs": { "url": "https://github.com/signalridge/pi-extensions/issues" },
  "publishConfig": { "access": "public" }
}
