{
  "name": "@signalridge/pi-codex-compact",
  "version": "1.2.2",
  "description": "Experimental Codex Remote Compaction V2 for Pi's OpenAI Codex provider.",
  "type": "module",
  "license": "MIT",
  "private": false,
  "keywords": [
    "pi-package",
    "pi-extension",
    "pi",
    "codex",
    "compaction",
    "openai"
  ],
  "files": [
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "src"
  ],
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "piExtension": {
    "lifecycle": "experimental"
  },
  "scripts": {
    "check": "biome check --vcs-use-ignore-file=false src test package.json tsconfig.json README.md && npm run typecheck && npm run test",
    "format": "biome check --write --vcs-use-ignore-file=false src test package.json tsconfig.json README.md",
    "typecheck": "tsc --noEmit",
    "test": "vitest run test --config vitest.config.ts",
    "lint": "biome check ."
  },
  "dependencies": {
    "@narumitw/pi-tui-kit": "^0.54.0",
    "@signalridge/pi-ui": "^1.2.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-agent-core": "^0.84.0",
    "@earendil-works/pi-ai": "^0.84.0",
    "@earendil-works/pi-coding-agent": "^0.84.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.7",
    "@earendil-works/pi-agent-core": "0.84.1",
    "@earendil-works/pi-ai": "0.84.1",
    "@earendil-works/pi-coding-agent": "0.84.1",
    "@types/node": "26.1.2",
    "typescript": "7.0.2"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/signalridge/pi-extensions",
    "directory": "packages/pi-codex-compact"
  },
  "homepage": "https://github.com/signalridge/pi-extensions/tree/main/packages/pi-codex-compact",
  "bugs": {
    "url": "https://github.com/signalridge/pi-extensions/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
