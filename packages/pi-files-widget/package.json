{
  "name": "@signalridge/pi-files-widget",
  "version": "1.2.9",
  "description": "In-terminal file browser and viewer for Pi.",
  "license": "MIT",
  "author": "Thomas Mustier",
  "keywords": [
    "pi-package"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/signalridge/pi-extensions",
    "directory": "packages/pi-files-widget"
  },
  "bugs": {
    "url": "https://github.com/signalridge/pi-extensions/issues"
  },
  "homepage": "https://github.com/signalridge/pi-extensions/tree/main/packages/pi-files-widget",
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "scripts": {
    "postinstall": "node -e \"console.log('pi-files-widget: required deps: bat, delta, glow. ' + (process.platform === 'darwin' ? 'Install with: brew install bat git-delta glow' : 'Install instructions: https://github.com/signalridge/pi-extensions/tree/main/packages/pi-files-widget#install'))\"",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "test": "bun test test",
    "check": "bun run lint && bun run typecheck && bun run test",
    "format": "biome check --write ."
  },
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "1.5.0",
    "@earendil-works/pi-tui": "1.5.0"
  },
  "dependencies": {
    "@signalridge/pi-ui": "^1.5.0"
  },
  "type": "module",
  "private": false,
  "publishConfig": {
    "access": "public"
  },
  "piExtension": {
    "lifecycle": "stable"
  },
  "files": [
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "*.ts"
  ]
}
