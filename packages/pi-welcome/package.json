{
  "name": "@signalridge/pi-welcome",
  "version": "1.3.5",
  "description": "Startup resource and repository summary card for Pi.",
  "type": "module",
  "license": "MIT",
  "private": false,
  "piExtension": {
    "lifecycle": "stable"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "^0.84.0",
    "@earendil-works/pi-tui": "^0.84.0"
  },
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/signalridge/pi-extensions",
    "directory": "packages/pi-welcome"
  },
  "homepage": "https://github.com/signalridge/pi-extensions/tree/main/packages/pi-welcome",
  "bugs": {
    "url": "https://github.com/signalridge/pi-extensions/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "src"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "test": "bun test test",
    "check": "bun run lint && bun run typecheck && bun run test",
    "format": "biome check --write ."
  }
}
