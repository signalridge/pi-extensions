{
  "name": "@signalridge/pi-ask-user-question",
  "version": "1.3.0",
  "description": "Structured user question tool for Pi agents.",
  "type": "module",
  "license": "MIT",
  "private": false,
  "keywords": [
    "pi-package",
    "pi-extension",
    "pi",
    "ask-user-question",
    "llm-tool",
    "tui"
  ],
  "files": [
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "src"
  ],
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "piExtension": {
    "lifecycle": "stable"
  },
  "scripts": {
    "check": "biome check . && npm run typecheck && npm run test",
    "format": "biome check --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run test --config vitest.config.ts",
    "lint": "biome check ."
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "^0.84.0",
    "@earendil-works/pi-tui": "^0.84.0",
    "typebox": "^1.3.11"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.7",
    "@earendil-works/pi-coding-agent": "0.84.1",
    "@earendil-works/pi-tui": "0.84.1",
    "typebox": "1.3.11",
    "typescript": "7.0.2",
    "vitest": "4.0.18"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/signalridge/pi-extensions",
    "directory": "packages/pi-ask-user-question"
  },
  "homepage": "https://github.com/signalridge/pi-extensions/tree/main/packages/pi-ask-user-question",
  "bugs": {
    "url": "https://github.com/signalridge/pi-extensions/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
