{
  "name": "@signalridge/pi-btw",
  "version": "1.4.3",
  "description": "Pi extension that adds a /btw side-question command.",
  "type": "module",
  "license": "MIT",
  "private": false,
  "keywords": [
    "pi-package",
    "pi-extension",
    "pi",
    "btw",
    "side-question"
  ],
  "files": [
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "src"
  ],
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "piExtension": {
    "lifecycle": "stable"
  },
  "scripts": {
    "check": "biome check . && npm run typecheck && npm run test",
    "format": "biome check --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run test --config vitest.config.ts",
    "lint": "biome check ."
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.7",
    "@earendil-works/pi-ai": "1.0.4",
    "@earendil-works/pi-coding-agent": "1.0.4",
    "@earendil-works/pi-tui": "1.0.4",
    "typescript": "7.0.2"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/signalridge/pi-extensions",
    "directory": "packages/pi-btw"
  },
  "dependencies": {
    "@narumitw/pi-tui-kit": "^0.54.0",
    "@signalridge/pi-ui": "^1.4.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "homepage": "https://github.com/signalridge/pi-extensions/tree/main/packages/pi-btw",
  "bugs": {
    "url": "https://github.com/signalridge/pi-extensions/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
